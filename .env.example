# Required for production
#MONGODB_URI=mongodb+srv://user:password@cluster/fynovo
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ENCRYPTION_KEY=base64-encoded-32-byte-key

# Optional cron protection and sync schedule integration
CRON_SECRET=replace-this-secret

# MongoDB Atlas credentials
MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fynovo?retryWrites=true&w=majority
